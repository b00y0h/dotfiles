# ── Node version management via n (auto-switch per project .node-version) ──
export N_PREFIX="/usr/local"
_n_auto_switch() {
  emulate -L zsh
  local f v cur
  for f in .node-version .nvmrc; do
    [[ -r $f ]] || continue
    v=$(<"$f"); v=${v//[$' \t\r\nv']/}; break
  done
  [[ -n $v ]] || return
  cur=$(command node -v 2>/dev/null); cur=${cur#v}
  [[ $cur == $v ]] && return
  if [[ -x $N_PREFIX/n/versions/node/$v/bin/node ]]; then
    n "$v" >/dev/null 2>&1
  else
    print -P "%F{yellow}node $v required by this project (.node-version) — run: n install $v%f"
  fi
}
autoload -U add-zsh-hook
add-zsh-hook chpwd _n_auto_switch
