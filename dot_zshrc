# zoxide-backed `cd` that never GUESSES at a path-shaped argument.
#
# `alias cd="z"` was unsafe: zoxide's z only does a plain cd when the argument is
# an existing directory -- otherwise it falls through to a frecency query. So a
# relative path that doesn't resolve from the current directory (typo, or simply
# being in a different checkout than you assumed) did NOT fail. It silently
# teleported to the most-visited similarly-named directory and returned exit 0,
# which let `cd apps/foo && git rm ...` run against the wrong repo entirely.
#
# Bare keywords still get the frecency jump (`cd meridian`). Anything that looks
# like a path -- contains "/", or starts with "." "~" "-" -- goes to builtin cd
# and fails loudly when it doesn't exist, so `&&` chains short-circuit correctly.
cd() {
  if (( $# != 1 )) || [[ "$1" == -* || "$1" == */* || "$1" == .* || "$1" == ~* || -d "$1" ]]; then
    builtin cd "$@"
  else
    __zoxide_z "$1"
  fi
}

