# Sensitive credential files - NEVER sync these
.npmrc
.netrc
.git-credentials
.aws/credentials
.aws/config
# .ssh: deny-by-default. Name-pattern rules (id_rsa*, id_ed25519*) miss any
# key with a custom name, so ignore the whole tree and re-allow explicitly.
.ssh/**
!.ssh/sockets

# Credential stores for CLIs that write tokens to disk in plaintext
.config/gh/hosts.yml
.config/glab-cli/**
.kube/**
.docker/config.json
.gnupg/**
.password-store/**
.config/op/**
.terraform.d/credentials.tfrc.json
.databricks-cfg
.snowflake/**
.pgpass
.my.cnf

# Machine-local shell overrides (holds secrets; must never be synced)
.zshrc.local

# API tokens and secrets
.contentfulrc.json
.serverlessrc
.veracodeid
.opencommit
.claude.json
.claude.json.backup

# Machine-specific or auto-generated files
.CFUserTextEncoding
.DS_Store
**/.DS_Store
.lesshst
.bash_history
.node_repl_history
.python_history
.dbshell
.mongorc.js
.moodTable.json
.rnd
.autoenv_authorized

# Application-specific that may contain tokens
.yarnrc
.bunfig.toml

